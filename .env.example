# TG Checkin 配置示例 —— 复制为 .env 后按需修改
# 所有变量都可以通过 docker-compose 的 environment 覆盖

# ---------------- 管理员账号 ----------------
ADMIN_USERNAME=admin
# 强烈建议修改！留空则使用默认密码 admin123，并会在面板中提示修改
ADMIN_PASSWORD=
# 登录令牌与密钥加密的派生种子；留空会自动生成并保存在 data/.secret_key
# 迁移服务器时把它一起带走，否则已保存的 Telegram 会话将无法解密
SECRET_KEY=

# ---------------- 服务 ----------------
# 监听端口；也可以用 ./scripts/deploy.sh -p 9000 设置
PORT=8000
TZ=Asia/Shanghai
# SQLite 数据目录（容器内固定为 /app/data）
DATA_DIR=./data

# ---------------- 可选 ----------------
# DEBUG=true 会开启 /api/docs 与宽松的 CORS，仅用于本地开发
DEBUG=false
